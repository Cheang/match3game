[sub_resource type="Resource" id="Resource_30f5c"]
script = ExtResource("1_75siy")
title = "Tale of the Lamia"
description = Array[String](["You are sitting at a table, outside of the local kruchma in a village called Chenger, sipping from a wooden cup. Your outfit and mask drawing a lot of attention to yourself.", "[color=#91db69]\"Ah, I see a Kuker has graced our humble village. It's been many years since I've seen one of your kind.” [/color]
The old man approaches the table, leaning heavily on his cane. His eyes are sharp and filled with stories of the past.", "[color=#91db69]\"I couldn't help but notice your attire. You must be here to rid us of the dark creatures that plague our land.” [/color]
You nod solemnly, setting your cup down. 
[color=#91db69]\"There is one beast in particular that haunts these parts... a Lamia, a monstrous serpent that dwells in the wilds. Many have tried to slay it, but none have returned.”[/color]", "[color=#91db69]\"They say its eyes can hypnotize and its venom is deadly. If anyone can defeat it, it would be a Kuker like you. Please, rid us of this terror.”[/color]
You promise the old man to look into this creature a put it down for good."])
npc = Array[Texture2D]([null, ExtResource("2_s82tq"), ExtResource("2_s82tq"), ExtResource("2_s82tq")])
background = ExtResource("1_ykgu2")
next_location = "res://scenes/locations_screen.tscn"


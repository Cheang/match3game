[resource]
script = ExtResource("2_g8liw")
categorie = "Service"
title = "Kruchma"
description = "The dimly lit kruchma is alive with lively folk music from a gadulka, tambura, and kaval trio. Smoke-stained beams support the low ceiling, and the warm glow of an open hearth casts flickering shadows on the rough-hewn walls adorned with rugs and copperware. Villagers share stories at wooden tables over rakia, roasted lamb, bread, and fresh cheese."

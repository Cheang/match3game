[resource]
script = ExtResource("2_g8liw")
categorie = "Service"
title = "Kruchma"
description = "The dimly lit kruchma is alive with the sound of lively folk music, as a trio of musicians plays a gadulka, tambura, and kaval in the corner, their melodies weaving through the air. Wooden beams stained with smoke support the low ceiling, and the warm glow of an open hearth casts flickering shadows on the rough-hewn walls adorned with woven rugs and copperware. Villagers sit at sturdy wooden tables, sharing stories over clay jugs of rakia and plates of roasted lamb, bread, and fresh cheese"
